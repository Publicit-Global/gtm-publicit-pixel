___TESTS___

scenarios:
- name: Invalid key fails without loading the script
  code: |-
    runCode({pixelKey: 'abc', eventType: 'pageview', consentMode: 'gcm'});
    assertApi('injectScript').wasNotCalled();
    assertApi('gtmOnFailure').wasCalled();
- name: Page view loads the pixel script with the key in the URL
  code: |-
    runCode({pixelKey: 'pk_test_abcdefghijkl', eventType: 'pageview', consentMode: 'cmp'});
    assertApi('createArgumentsQueue').wasCalledWith('publicit', 'publicit.q');
    assertApi('injectScript').wasCalled();
    assertThat(injectedUrl).isEqualTo('https://px.publicit.com/p.js?k=pk_test_abcdefghijkl');
    assertApi('callInWindow').wasNotCalled();
    assertApi('gtmOnSuccess').wasCalled();
- name: Consent mode granted sends consent
  code: |-
    mock('isConsentGranted', (type) => true);
    runCode({pixelKey: 'pk_test_abcdefghijkl', eventType: 'pageview', consentMode: 'gcm'});
    assertApi('callInWindow').wasCalledWith('publicit', 'consent', true);
    assertApi('addConsentListener').wasNotCalled();
- name: Consent mode denied waits for a consent update
  code: |-
    mock('isConsentGranted', (type) => false);
    runCode({pixelKey: 'pk_test_abcdefghijkl', eventType: 'pageview', consentMode: 'gcm'});
    assertApi('callInWindow').wasNotCalled();
    assertApi('addConsentListener').wasCalled();
- name: Purchase queues value currency and order id
  code: |-
    runCode({pixelKey: 'pk_test_abcdefghijkl', eventType: 'purchase', value: '49.90', currency: 'eur', orderId: 'A-1001', consentMode: 'always'});
    assertApi('callInWindow').wasCalledWith('publicit', 'consent', true);
    assertApi('callInWindow').wasCalledWith('publicit', 'track', 'purchase', {value: 49.9, currency: 'EUR', order_id: 'A-1001'});
- name: Purchase without value omits it
  code: |-
    runCode({pixelKey: 'pk_test_abcdefghijkl', eventType: 'purchase', value: '', currency: 'EUR', orderId: '', consentMode: 'cmp'});
    assertApi('callInWindow').wasCalledWith('publicit', 'track', 'purchase', {currency: 'EUR'});
- name: Custom event is lowercased
  code: |-
    runCode({pixelKey: 'pk_test_abcdefghijkl', eventType: 'custom', eventName: 'Lead', consentMode: 'cmp'});
    assertApi('callInWindow').wasCalledWith('publicit', 'track', 'lead');
setup: |-
  let injectedUrl;
  mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
    injectedUrl = url;
    onSuccess();
  });


