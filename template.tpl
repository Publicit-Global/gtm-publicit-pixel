___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// Publicit Pixel · Google Tag Manager tag template.
// Sandboxed JavaScript: only require() APIs, no direct window access.
const injectScript = require('injectScript');
const createArgumentsQueue = require('createArgumentsQueue');
const callInWindow = require('callInWindow');
const encodeUriComponent = require('encodeUriComponent');
const isConsentGranted = require('isConsentGranted');
const addConsentListener = require('addConsentListener');
const makeNumber = require('makeNumber');
const makeString = require('makeString');
const getType = require('getType');
const log = require('logToConsole');

const SCRIPT_URL = 'https://px.publicit.com/p.js';

const key = makeString(data.pixelKey || '').trim();
if (key.indexOf('pk_live_') !== 0 && key.indexOf('pk_test_') !== 0) {
  log('Publicit Pixel: invalid pixel key');
  data.gtmOnFailure();
  return;
}

// Same stub as the other integrations: window.publicit queues its arguments in
// window.publicit.q until p.js loads and replays them.
createArgumentsQueue('publicit', 'publicit.q');

// ── Consent ──────────────────────────────────────────────────────────────────────
// gcm    → Google Consent Mode: ad_storage and ad_user_data granted (now or later).
// cmp    → p.js detects it by itself (TCF v2 CMP or Publicit's CMP).
// always → the container already gates this tag on consent (trigger or consent settings).
let granted = false;
const grant = () => {
  if (granted) return;
  granted = true;
  callInWindow('publicit', 'consent', true);
};
const gcmGranted = () => isConsentGranted('ad_storage') && isConsentGranted('ad_user_data');

if (data.consentMode === 'always') {
  grant();
} else if (data.consentMode !== 'cmp') {
  if (gcmGranted()) {
    grant();
  } else {
    const onChange = () => { if (gcmGranted()) grant(); };
    addConsentListener('ad_storage', onChange);
    addConsentListener('ad_user_data', onChange);
  }
}

// ── Event ────────────────────────────────────────────────────────────────────────
// p.js sends the page visit once consent is granted; this only adds purchases and events.
if (data.eventType === 'purchase') {
  const props = {};
  if (getType(data.value) !== 'undefined' && makeString(data.value) !== '') {
    const value = makeNumber(data.value);
    if (value === value && value >= 0) props.value = value;
  }
  const currency = makeString(data.currency || '').trim().toUpperCase();
  if (currency.length === 3) props.currency = currency;
  const orderId = makeString(data.orderId || '').trim();
  if (orderId) props.order_id = orderId;
  callInWindow('publicit', 'track', 'purchase', props);
} else if (data.eventType === 'custom') {
  const name = makeString(data.eventName || '').trim().toLowerCase();
  if (name) callInWindow('publicit', 'track', name);
}

injectScript(SCRIPT_URL + '?k=' + encodeUriComponent(key), data.gtmOnSuccess, data.gtmOnFailure, 'publicit-pixel-' + key);


